 649:Library/Src/fifo.c **** //******************************************************************************************
 650:Library/Src/fifo.c **** //
 651:Library/Src/fifo.c **** //! \brief  Create An New FIFO Instance.
 652:Library/Src/fifo.c **** //! This function allocate enought room for N blocks fifo elements, then return the pointer
 653:Library/Src/fifo.c **** //! of FIFO.
 654:Library/Src/fifo.c **** //!
 655:Library/Src/fifo.c **** //! \param  [in] UnitSize is fifo element size.
 656:Library/Src/fifo.c **** //! \param  [in] UnitCnt is count of fifo elements.
 657:Library/Src/fifo.c **** //! \retval The Pointer of FIFO instance, return NULL is failure to allocate memory.
 658:Library/Src/fifo.c **** //!
 659:Library/Src/fifo.c **** //! \note   -# You must enable USE_MEMORY_ALLOC macro and ensure your system have <stdlib.h>
 660:Library/Src/fifo.c **** //!            Header file before use this function.
 661:Library/Src/fifo.c **** //! \note   -# Functions FIFO_Create and FIFO_Destory must be used in pairs.
 662:Library/Src/fifo.c **** //!
 663:Library/Src/fifo.c **** //******************************************************************************************
 664:Library/Src/fifo.c **** fifo_t *fifo_create(char unit_size, int unit_cnt)
 665:Library/Src/fifo.c **** {
 666:Library/Src/fifo.c ****   fifo_t *p_fifo = NULL;    //!< FIFO Pointer
 667:Library/Src/fifo.c ****   char *p_base_addr = NULL; //!< Memory Base Address
 668:Library/Src/fifo.c **** 
 669:Library/Src/fifo.c ****   //! Check input parameters.
 670:Library/Src/fifo.c ****   ASSERT(unit_size);
 671:Library/Src/fifo.c ****   ASSERT(unit_cnt);
 672:Library/Src/fifo.c **** 
 673:Library/Src/fifo.c ****   //! Allocate Memory for pointer of new FIFO Control Block.
 674:Library/Src/fifo.c ****   p_fifo = (fifo_t *)malloc(sizeof(fifo_t));
 675:Library/Src/fifo.c ****   if (NULL == p_fifo)
 676:Library/Src/fifo.c ****   {
 677:Library/Src/fifo.c ****     //! Allocate Failure, exit now.
 678:Library/Src/fifo.c ****     return (NULL);
 679:Library/Src/fifo.c ****   }
 680:Library/Src/fifo.c **** 
 681:Library/Src/fifo.c ****   //! Allocate memory for FIFO.
 682:Library/Src/fifo.c ****   p_base_addr = malloc(unit_size * unit_cnt);
 683:Library/Src/fifo.c ****   if (NULL == p_base_addr)
 684:Library/Src/fifo.c ****   {
 685:Library/Src/fifo.c ****     //! Allocate Failure, exit now.
 686:Library/Src/fifo.c ****     free(p_fifo);
 687:Library/Src/fifo.c ****     return (NULL);
 688:Library/Src/fifo.c ****   }
 689:Library/Src/fifo.c **** 
 690:Library/Src/fifo.c ****   //! Initialize General FIFO Module.
 691:Library/Src/fifo.c ****   fifo_init(p_fifo, p_base_addr, unit_size, unit_cnt);
 692:Library/Src/fifo.c **** 
 693:Library/Src/fifo.c ****   return (p_fifo);
 694:Library/Src/fifo.c **** }
