  27:Library/Src/fifo.c **** //! \brief  Create An New FIFO Instance(in Single Mode).
  28:Library/Src/fifo.c **** //! This function allocate enought room for N blocks fifo elements, then return the pointer
  29:Library/Src/fifo.c **** //! of FIFO.
ARM GAS  C:\Users\cyz19\AppData\Local\Temp\ccXlZxSa.s 			page 2


  30:Library/Src/fifo.c **** //!
  31:Library/Src/fifo.c **** //! \param  [in] uint_cnt is count of fifo elements.
  32:Library/Src/fifo.c **** //! \retval The Pointer of FIFO instance, return NULL is failure to allocate memory.
  33:Library/Src/fifo.c **** //!
  34:Library/Src/fifo.c **** //! \note   -# You must enable USE_MEMORY_ALLOC macro and ensure your system have <stdlib.h>
  35:Library/Src/fifo.c **** //!            Header file before use this function.
  36:Library/Src/fifo.c **** //! \note   -# Functions FIFO_Create and FIFO_Destory must be used in pairs.
  37:Library/Src/fifo.c **** //!
  38:Library/Src/fifo.c **** //******************************************************************************************
  39:Library/Src/fifo.c **** fifo_s_t *fifo_s_create(int uint_cnt)
  40:Library/Src/fifo.c **** {
  41:Library/Src/fifo.c ****   fifo_s_t *p_fifo = NULL;  //!< FIFO Pointer
  42:Library/Src/fifo.c ****   char *p_base_addr = NULL; //!< Memory Base Address
  43:Library/Src/fifo.c **** 
  44:Library/Src/fifo.c ****   //! Check input parameters.
  45:Library/Src/fifo.c ****   ASSERT(uint_cnt);
  46:Library/Src/fifo.c **** 
  47:Library/Src/fifo.c ****   //! Allocate Memory for pointer of new FIFO Control Block
  48:Library/Src/fifo.c ****   p_fifo = (fifo_s_t *)malloc(sizeof(fifo_s_t));
  49:Library/Src/fifo.c ****   if (NULL == p_fifo)
  50:Library/Src/fifo.c ****   {
  51:Library/Src/fifo.c ****     //! Allocate Failure, exit now
  52:Library/Src/fifo.c ****     return (NULL);
  53:Library/Src/fifo.c ****   }
  54:Library/Src/fifo.c ****   //! Allocate Memory for pointer of new FIFO
  55:Library/Src/fifo.c ****   p_base_addr = malloc(uint_cnt);
  56:Library/Src/fifo.c ****   if (NULL == p_base_addr)
  57:Library/Src/fifo.c ****   {
  58:Library/Src/fifo.c ****     //! Allocate Failure, exit now
  59:Library/Src/fifo.c ****     free(p_fifo);
  60:Library/Src/fifo.c ****     return (NULL);
  61:Library/Src/fifo.c ****   }
  62:Library/Src/fifo.c ****   //! Initialize General FIFO Module
  63:Library/Src/fifo.c ****   fifo_s_init(p_fifo, p_base_addr, uint_cnt);
  64:Library/Src/fifo.c **** 
  65:Library/Src/fifo.c ****   return (p_fifo);
  66:Library/Src/fifo.c **** }
