 158:Library/Src/BMI088.c **** void BMI088_read(float gyro[3], float accel[3], float *temperate)
 159:Library/Src/BMI088.c **** {
 160:Library/Src/BMI088.c ****     uint8_t buf[8] = {0, 0, 0, 0, 0, 0};
 161:Library/Src/BMI088.c ****     int16_t bmi088_raw_temp;
 162:Library/Src/BMI088.c **** 
 163:Library/Src/BMI088.c ****     BMI088_accel_read_muli_reg(BMI088_ACCEL_XOUT_L, buf, 6);
 164:Library/Src/BMI088.c ****     
 165:Library/Src/BMI088.c ****     bmi088_raw_temp = (int16_t)((buf[1]) << 8) | buf[0];
 166:Library/Src/BMI088.c ****     accel[0] = bmi088_raw_temp * BMI088_ACCEL_SEN;
 167:Library/Src/BMI088.c ****     bmi088_raw_temp = (int16_t)((buf[3]) << 8) | buf[2];
 168:Library/Src/BMI088.c ****     accel[1] = bmi088_raw_temp * BMI088_ACCEL_SEN;
 169:Library/Src/BMI088.c ****     bmi088_raw_temp = (int16_t)((buf[5]) << 8) | buf[4];
 170:Library/Src/BMI088.c ****     accel[2] = bmi088_raw_temp * BMI088_ACCEL_SEN;
 171:Library/Src/BMI088.c ****     
 172:Library/Src/BMI088.c ****     BMI088_gyro_read_muli_reg(BMI088_GYRO_CHIP_ID, buf, 8);
 173:Library/Src/BMI088.c ****     if(buf[0] == BMI088_GYRO_CHIP_ID_VALUE)
 174:Library/Src/BMI088.c ****     {
 175:Library/Src/BMI088.c ****         bmi088_raw_temp = (int16_t)((buf[3]) << 8) | buf[2];
 176:Library/Src/BMI088.c ****         gyro[0] = bmi088_raw_temp * BMI088_GYRO_SEN;
 177:Library/Src/BMI088.c ****         bmi088_raw_temp = (int16_t)((buf[5]) << 8) | buf[4];
 178:Library/Src/BMI088.c ****         gyro[1] = bmi088_raw_temp * BMI088_GYRO_SEN;
 179:Library/Src/BMI088.c ****         bmi088_raw_temp = (int16_t)((buf[7]) << 8) | buf[6];
 180:Library/Src/BMI088.c ****         gyro[2] = bmi088_raw_temp * BMI088_GYRO_SEN;
 181:Library/Src/BMI088.c ****     }
 182:Library/Src/BMI088.c ****     BMI088_accel_read_muli_reg(BMI088_TEMP_M, buf, 2);
 183:Library/Src/BMI088.c ****     
 184:Library/Src/BMI088.c ****     bmi088_raw_temp = (int16_t)((buf[0] << 3) | (buf[1] >> 5));
 185:Library/Src/BMI088.c **** 
 186:Library/Src/BMI088.c ****     if (bmi088_raw_temp > 1023)
 187:Library/Src/BMI088.c ****     {
 188:Library/Src/BMI088.c ****         bmi088_raw_temp -= 2048;
 189:Library/Src/BMI088.c ****     }
 190:Library/Src/BMI088.c ****     
 191:Library/Src/BMI088.c ****     *temperate = bmi088_raw_temp * BMI088_TEMP_FACTOR + BMI088_TEMP_OFFSET;
 192:Library/Src/BMI088.c **** }
